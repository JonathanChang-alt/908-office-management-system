# 后端环境变量示例（不含任何真实值）
# 复制为 .env 后填写真实值，.env 已被 .gitignore 排除

# 服务端口（默认 3001）
PORT=3001

# 微信小程序 AppID
WECHAT_APPID=your_wechat_appid

# 微信小程序 AppSecret（严禁提交真实值）
WECHAT_SECRET=your_wechat_app_secret

# 管理员 OpenID 白名单（逗号分隔多个；留空则无管理员，不影响普通用户登录）
ADMIN_OPENIDS=openid_example_1,openid_example_2

# 绑定码（可选；不配置则初始化时不创建对应绑定码，管理员绑定码请勿使用弱默认值）
ADMIN_BIND_CODE=your_admin_bind_code
STAFF_BIND_CODE=your_staff_bind_code
REVIEW_BIND_CODE=your_review_bind_code
