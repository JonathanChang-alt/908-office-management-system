.mat-tabs { display:flex; background:#fff; border-bottom:2rpx solid #e8e8e8; position:sticky; top:0; z-index:10; }
.mat-tab { flex:1; text-align:center; padding:24rpx 0; font-size:28rpx; color:#666; }
.mat-tab.on { color:#2f5597; font-weight:600; border-bottom:4rpx solid #2f5597; }

.duty-action-bar { display:flex; gap:12rpx; margin-bottom:16rpx; flex-wrap:wrap; }

/* ===== 值班卡片 ===== */
.duty-card {
  background:#fff; border-radius:12rpx; padding:24rpx; margin-bottom:16rpx;
  border:2rpx solid #e8ebf2; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03);
  transition:all 0.2s;
}
.duty-card:active { background:#f8f9fb; }
.duty-sel { border-color:#2f5597; background:#e8f0fe; box-shadow:0 2rpx 12rpx rgba(47,85,151,0.12); }

.duty-card-date { display:flex; align-items:baseline; gap:16rpx; margin-bottom:14rpx; padding-bottom:12rpx; border-bottom:1rpx solid #eef1f6; }
.duty-date { font-size:30rpx; font-weight:700; color:#1a1d28; }
.duty-weekday { font-size:24rpx; color:#5a7bb5; }

.duty-card-body { display:flex; flex-direction:column; gap:10rpx; }
.duty-field { display:flex; align-items:flex-start; line-height:1.6; }
.duty-label { font-size:24rpx; color:#888; width:130rpx; flex-shrink:0; }
.duty-value { font-size:26rpx; color:#333; }
.duty-value.person { font-weight:600; color:#2f5597; }

/* 打卡记录操作栏 */
.duty-card-actions { display:flex; gap:12rpx; justify-content:flex-end; padding-top:16rpx; margin-top:14rpx; border-top:1rpx solid #eef1f6; }