.mat-tabs { display:flex; background:#fff; border-bottom:2rpx solid #e8e8e8; position:sticky; top:0; z-index:10; }
.mat-tab { flex:1; text-align:center; padding:24rpx 0; font-size:28rpx; color:#666; }
.mat-tab.on { color:#2f5597; font-weight:600; border-bottom:4rpx solid #2f5597; }
.action-bar { margin-bottom:16rpx; }

/* ===== 状态标签 ===== */
.status-tag { display:inline-block; padding:6rpx 18rpx; border-radius:20rpx; font-size:22rpx; font-weight:600; }
.s-normal { background:#e8f7ed; color:#2f9b55; }
.s-empty { background:#fff3df; color:#d48806; }
.s-damaged { background:#ffecec; color:#d93026; font-weight:700; }

/* ===== 物资卡片 ===== */
.mat-card { background:#fff; border-radius:12rpx; padding:24rpx; margin-bottom:16rpx; box-shadow:0 2rpx 10rpx rgba(0,0,0,0.05); border:1rpx solid #eef1f6; }
.mat-card-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16rpx; padding-bottom:14rpx; border-bottom:1rpx solid #f0f0f0; }
.mat-card-title { font-size:32rpx; font-weight:700; color:#1a1d28; }
.mat-card-badge { flex-shrink:0; }
.mat-card-body { display:flex; flex-direction:column; gap:10rpx; margin-bottom:16rpx; }
.mat-field { display:flex; align-items:flex-start; line-height:1.6; }
.mat-label { font-size:24rpx; color:#888; width:100rpx; flex-shrink:0; }
.mat-value { font-size:26rpx; color:#333; word-break:break-all; }
.mat-value.code { font-family:monospace; color:#5a7bb5; font-size:24rpx; }
.mat-value.stock { font-weight:700; color:#2f5597; font-size:28rpx; }
.mat-card-actions { display:flex; gap:12rpx; justify-content:flex-end; padding-top:14rpx; border-top:1rpx solid #f0f0f0; }

/* ===== 借用 + 旧式 ===== */
.picker-box { width:100%; height:80rpx; display:flex; align-items:center; justify-content:space-between; padding:0 20rpx; border:2rpx solid #e0e0e0; border-radius:8rpx; font-size:28rpx; background:#fafafa; box-sizing:border-box; }
.picker-empty { color:#bbb; }
.picker-arrow { font-size:20rpx; color:#999; }
.info-card { background:linear-gradient(135deg,#e8f0fe,#d4e4fc); border-radius:12rpx; padding:20rpx 24rpx; margin-bottom:24rpx; border-left:6rpx solid #2f5597; }
.info-header { display:flex; align-items:baseline; gap:16rpx; margin-bottom:14rpx; padding-bottom:14rpx; border-bottom:1rpx solid rgba(47,85,151,0.2); }
.info-name { font-size:30rpx; font-weight:700; color:#2f5597; }
.info-code { font-size:22rpx; color:#5a7bb5; font-family:monospace; }
.info-row { display:flex; justify-content:space-between; padding:6rpx 0; }
.info-label { font-size:24rpx; color:#5a6378; }
.info-val { font-size:26rpx; color:#2c313a; font-weight:500; }
.info-green { font-size:28rpx; font-weight:700; color:#2e7d32; }

/* ===== textarea ===== */
.form-textarea { width:100%; min-height:120rpx; padding:14rpx 16rpx; border:2rpx solid #e0e0e0; border-radius:8rpx; font-size:26rpx; background:#fafafa; box-sizing:border-box; }

/* ===== 归还弹窗 ===== */
.ret-confirm { font-size:30rpx; font-weight:600; color:#333; text-align:center; padding:10rpx 0; }

/* ===== 借还记录卡片 ===== */
.rec-card { background:#fff; border-radius:12rpx; padding:22rpx; margin-bottom:16rpx; border:1rpx solid #eef1f6; box-shadow:0 1px 6rpx rgba(0,0,0,0.03); }
.rec-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:14rpx; padding-bottom:12rpx; border-bottom:1rpx solid #f0f0f0; }
.rec-title { font-size:28rpx; font-weight:700; color:#1a1d28; }
.rec-body { display:flex; flex-direction:column; gap:8rpx; }
.rec-row { display:flex; font-size:24rpx; color:#555; }
.rec-label { color:#888; width:130rpx; flex-shrink:0; }
.rec-row.note { margin-top:6rpx; padding-top:8rpx; border-top:1rpx dashed #e8e8e8; }
.rec-row.note .rec-label { font-weight:600; }
.rec-row.note.admin { border-top-color:#d4e4fc; }
.rec-note-txt { color:#555; flex:1; word-break:break-all; }
.rec-actions { display:flex; justify-content:flex-end; margin-top:14rpx; padding-top:14rpx; border-top:1rpx solid #f0f0f0; }