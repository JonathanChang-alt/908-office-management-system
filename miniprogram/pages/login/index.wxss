.login-page{min-height:100vh;background:linear-gradient(135deg,#e8f0fe,#d4e4fc,#c5d5f0);display:flex;flex-direction:column;align-items:center;padding:120rpx 40rpx 60rpx}
.login-header{text-align:center;margin-bottom:60rpx}
.logo{width:120rpx;height:120rpx;line-height:120rpx;background:#2f5597;color:#fff;font-size:40rpx;font-weight:800;border-radius:24rpx;margin:0 auto 24rpx;letter-spacing:4rpx;text-align:center}
.title{font-size:36rpx;font-weight:700;color:#1a1d28;margin-bottom:8rpx}
.subtitle{font-size:26rpx;color:#5a7bb5}
.login-card{width:100%;background:#fff;border-radius:16rpx;padding:40rpx 32rpx;box-shadow:0 8rpx 32rpx rgba(47,85,151,.12)}
.form-group{margin-bottom:28rpx}
.form-label{font-size:26rpx;color:#555;margin-bottom:10rpx;font-weight:500}
.form-input{width:100%;height:84rpx;padding:0 20rpx;border:2rpx solid #e0e0e0;border-radius:10rpx;font-size:28rpx;background:#f9fafb;box-sizing:border-box}
.btn-login{width:100%;height:88rpx;line-height:88rpx;background:#07c160;color:#fff;font-size:32rpx;font-weight:600;border:none;border-radius:10rpx;text-align:center}
.btn-login::after{border:none}
.hint{font-size:22rpx;color:#aaa;text-align:center;margin-top:20rpx;line-height:1.6}